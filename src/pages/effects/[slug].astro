---
import Base from '../../layouts/Base.astro';
import Configurator from '../../components/Configurator.tsx';
import { liveEntries, type CatalogueEntry } from '../../effects/catalogue';

export function getStaticPaths() {
  return liveEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CatalogueEntry };
const abouts = import.meta.glob('../../effects/*/About.astro', { eager: true }) as Record<string, { default: any }>;
const About = abouts[`../../effects/${entry.slug}/About.astro`]?.default;
---
<Base title={`${entry.name} · Snippetlab`} description={entry.summary}>
  <div class="wrap page">
    <header class="intro">
      <a class="back" href="/#catalogue">All effects</a>
      <p class="eyebrow">{entry.category}</p>
      <h1>{entry.name}</h1>
      <p class="summary">{entry.summary}</p>
    </header>

    <Configurator client:load slug={entry.slug} />

    {About && <About />}
  </div>
</Base>

<style>
  .page { display: flex; flex-direction: column; gap: 40px; padding-block: 32px 0; }
  .intro { display: flex; flex-direction: column; gap: 10px; }
  .back { font-size: 14px; color: var(--muted); text-decoration: none; width: fit-content; }
  .back::before { content: "← "; }
  .back:hover { color: var(--fg); }
  h1 { font-size: clamp(40px, 6vw, 68px); font-weight: 700; letter-spacing: -0.03em; }
  .summary { font-size: 18px; color: var(--muted); max-width: 60ch; margin: 0; }
</style>
